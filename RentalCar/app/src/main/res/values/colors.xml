<?xml version="1.0" encoding="utf-8"?>
<!--
  Bảng màu sáng (lấy từ sketch 01 và 05).
  Mỗi màu có một bản CÙNG TÊN trong values-night/colors.xml. Layout chỉ ghi @color/fu_bg,
  @color/fu_text... và Android tự chọn bản sáng hay tối, nên dark mode không cần thêm code layout.
  Độ tương phản theo WCAG: chữ >= 4.5:1, chữ lớn / thành phần giao diện >= 3:1.
  -->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Nền -->
    <color name="fu_bg">#F5F0E8</color>              <!-- nền trang màu kem -->
    <color name="fu_surface">#FFFDFA</color>
    <color name="fu_surface_variant">#ECE5DD</color>
    <color name="fu_outline">#D3CABF</color>

    <!-- Chữ -->
    <color name="fu_text">#12161B</color>
    <color name="fu_text_secondary">#625D57</color>  <!-- 5.8:1 trên fu_bg (màu xám cũ không đạt chuẩn) -->

    <!-- Màu đảo: ô credit, nút Next, thanh Back/Save, Snackbar -->
    <color name="fu_inverse">#12161B</color>
    <color name="fu_on_inverse">#FFFFFF</color>

    <!-- Cam thương hiệu. Chữ trên nền cam phải màu tối (4.9:1); chữ trắng không đạt chuẩn. -->
    <color name="fu_accent">#EA580C</color>
    <color name="fu_on_accent">#12161B</color>
    <!-- Cam dùng cho CHỮ cỡ thường ("Clear search"): 5.2:1 trên nền thẻ -->
    <color name="fu_accent_text">#C2410C</color>
    <color name="fu_accent_soft">#FDE7D9</color>

    <!-- Trạng thái -->
    <color name="fu_success">#1F7A45</color>
    <color name="fu_error">#B91C1C</color>
    <color name="fu_error_container">#FDECEC</color> <!-- hộp lỗi: chữ fu_error trên nền này = 5.6:1 -->
</resources>
