<?xml version="1.0" encoding="utf-8"?>
<!--
  Ô ảnh giấy tờ ("Driver ID Photo" / "Driver Licence Photo"), chạm để mở Photo Picker.
  Trạng thái: trống → Required (đỏ) → đã có ảnh (✓).
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_doc_tile"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:minHeight="@dimen/fu_touch_min"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="18dp"
    android:paddingEnd="8dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="56dp">

        <ImageView
            android:id="@+id/imgDoc"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:src="@drawable/ic_add_photo" />

        <ImageView
            android:id="@+id/imgDocCheck"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvDocTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/fu_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDocHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.FakeUber.Secondary"
        android:textSize="13sp" />
</LinearLayout>
