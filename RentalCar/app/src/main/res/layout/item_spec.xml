<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ thông số (icon + nhãn + giá trị): Seats / Fuel / Type. Dùng lại 3 lần. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_spec_card"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/imgSpec"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvSpecLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textAppearance="@style/TextAppearance.FakeUber.Secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvSpecValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textColor="@color/fu_text"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
